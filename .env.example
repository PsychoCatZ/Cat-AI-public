# Load through systemd EnvironmentFile, not committed secrets.
TELEGRAM_BOT_TOKEN=
OWNER_ID=0
# Only used with CHAT_SCOPE=pilot.
TEST_CHAT_ID=0
RESPONSES_ENABLED=false
# OpenAI API; token is configured separately through protected environment.
MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions
MODEL_API_KEY=
MODEL_NAME=gpt-6-luna
MODEL_PROVIDER_LABEL=OpenAI (GPT-6 Luna)
MODEL_PRIVACY_URL=https://developers.openai.com/api/docs/guides/your-data
STATE_PATH=data/state.sqlite3

# Public username of the connected owner, for consent draft links.
OWNER_USERNAME=

# pilot: only TEST_CHAT_ID; telegram: private chats authorized in Telegram.
CHAT_SCOPE=pilot
BOT_USERNAME=ExampleCatAIBot
